{
  "extends": "./tsconfig.app.json",

  // Только тесты, исключения сбрасываем. Код приложения подтягивается через импорты.
  "include": ["src/**/__tests__/*", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Тесты выполняются не в браузере, поэтому свои lib и types.
    "lib": [],
    "types": ["node", "jsdom"],

    // vue-tsc --build пишет .tsbuildinfo для инкрементальной проверки, держим его вне корня.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
