{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Строже, чем strict из @vue/tsconfig.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Только синтаксис, который можно просто стереть: TreeStore должен импортироваться
    // любым раннером тестов, в том числе Node.js без сборки.
    "erasableSyntaxOnly": true,

    // Импорты от src через @/.
    "paths": {
      "@/*": ["./src/*"]
    },

    // vue-tsc --build пишет .tsbuildinfo для инкрементальной проверки, держим его вне корня.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
